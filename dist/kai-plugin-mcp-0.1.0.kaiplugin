{"manifest":{"schema":2,"apiVersion":3,"id":"community.mcp-bridge","version":"0.1.0","name":"MCP Bridge","description":"Lets AI agents on this computer, such as Claude Code, use KAI through the Model Context Protocol. Off until you turn it on, local to this computer, and every change is approved by you in KAI.","entry":"index.html","runtime":"native","service":"service/index.js","permissions":["native.execute","models.read","models.manage","network.status","network.configure","storage.read","storage.write","secrets.use","services.call"],"provides":[],"consumes":["kai.documents","kai.workflows","kai.brain","kai.assistant","kai.code","kai.tools"]},"files":{"app.js":"\"use strict\";\n(function () {\n  const I = window.MCPBridgeI18n;\n  const $ = (id) => document.getElementById(id);\n  const SOURCE_ORDER = [\"documents\", \"workflows\", \"brain\", \"assistant\", \"code\", \"tools\"];\n  const PLUGIN_NAMES = { documents: \"Documents\", workflows: \"Workflows\", brain: \"Brain\", assistant: \"KAI Assistant\", code: \"Koinos Code\", tools: \"KAI Tools\" };\n  let state = null, token = null, showToken = false, busy = false, timer = null;\n\n  const call = (method, input) => window.kai.call(method, input || {});\n\n  function showError(message) {\n    const el = $(\"error\");\n    el.hidden = !message;\n    el.textContent = message || \"\";\n  }\n\n  async function act(fn) {\n    if (busy) return;\n    busy = true;\n    try { showError(\"\"); await fn(); }\n    catch (e) { showError(e && e.message ? e.message : String(e)); }\n    finally { busy = false; await refresh(); }\n  }\n\n  function configText(url, tok) {\n    const t = tok || \"<token>\";\n    $(\"cmd-claude\").value = `claude mcp add --transport http kai ${url} --header \"Authorization: Bearer ${t}\"`;\n    $(\"cmd-json\").value = JSON.stringify({ mcpServers: { kai: { type: \"http\", url, headers: { Authorization: `Bearer ${t}` } } } }, null, 2);\n  }\n\n  async function copy(text, button) {\n    let ok = false;\n    try { await navigator.clipboard.writeText(text); ok = true; } catch { /* fall back below */ }\n    if (!ok) {\n      const area = document.createElement(\"textarea\");\n      area.value = text; document.body.appendChild(area); area.select();\n      try { ok = document.execCommand(\"copy\"); } catch { ok = false; }\n      area.remove();\n    }\n    if (ok) {\n      const label = button.textContent;\n      button.textContent = I.t(\"copied\");\n      setTimeout(() => { button.textContent = label; }, 1200);\n    }\n  }\n\n  function renderSources() {\n    const box = $(\"sources\");\n    box.replaceChildren();\n    for (const key of SOURCE_ORDER) {\n      const label = document.createElement(\"label\");\n      label.className = \"check\";\n      const input = document.createElement(\"input\");\n      input.type = \"checkbox\";\n      input.checked = !!state.sources[key];\n      input.addEventListener(\"change\", () => act(() => call(\"bridge.configure\", { sources: { [key]: input.checked } })));\n      const text = document.createElement(\"span\");\n      const strong = document.createElement(\"strong\");\n      strong.textContent = I.t(`src.${key}`);\n      const small = document.createElement(\"small\");\n      small.textContent = `${I.t(`src.${key}.hint`)} ${I.t(\"needPlugin\", { name: PLUGIN_NAMES[key] })}`;\n      text.append(strong, small);\n      label.append(input, text);\n      box.append(label);\n    }\n  }\n\n  function renderActivity() {\n    const list = $(\"activity\");\n    list.replaceChildren();\n    const fmt = new Intl.DateTimeFormat(I.language, { timeStyle: \"medium\" });\n    if (!state.activity.length) {\n      const li = document.createElement(\"li\");\n      li.className = \"muted\";\n      li.textContent = I.t(\"noActivity\");\n      list.append(li);\n    }\n    for (const a of state.activity) {\n      const li = document.createElement(\"li\");\n      li.className = a.ok ? \"\" : \"bad\";\n      li.textContent = `${fmt.format(new Date(a.at))}  ${a.tool}  ${a.ok ? `${a.ms} ms` : I.t(\"failed\")}`;\n      list.append(li);\n    }\n    $(\"client\").textContent = state.lastClient\n      ? I.t(\"lastClient\", { name: `${state.lastClient.name} ${state.lastClient.version}`.trim(), time: fmt.format(new Date(state.lastClient.at)) })\n      : \"\";\n  }\n\n  function render() {\n    if (!state) return;\n    const pill = $(\"pill\");\n    const problem = !state.running && state.lastError;\n    pill.textContent = I.t(state.running ? \"pillOn\" : problem ? \"pillError\" : \"pillOff\");\n    pill.className = `pill ${state.running ? \"pill-on\" : problem ? \"pill-error\" : \"pill-off\"}`;\n    $(\"state-text\").textContent = I.t(state.running ? \"stateOn\" : \"stateOff\");\n    $(\"toggle\").textContent = I.t(state.running ? \"turnOff\" : \"turnOn\");\n    if (problem) showError(state.lastError);\n\n    $(\"connect\").hidden = !state.running;\n    $(\"url\").value = state.url;\n    $(\"token\").type = showToken ? \"text\" : \"password\";\n    $(\"token\").value = token || \"\";\n    $(\"show-token\").textContent = I.t(showToken ? \"hide\" : \"show\");\n    configText(state.url, showToken ? token : null);\n\n    if (document.activeElement !== $(\"port\")) $(\"port\").value = state.port;\n    $(\"allow-changes\").checked = state.allowChanges;\n    $(\"tool-count\").textContent = I.t(\"toolCount\", { n: state.toolCount });\n    renderSources();\n    renderActivity();\n  }\n\n  async function refresh() {\n    try {\n      state = await call(\"bridge.status\");\n      if (state.running && !token) token = (await call(\"bridge.token\")).token;\n      render();\n    } catch (e) { showError(e && e.message ? e.message : String(e)); }\n  }\n\n  $(\"toggle\").addEventListener(\"click\", () => act(async () => {\n    if (state && state.running) await call(\"bridge.stop\");\n    else { await call(\"bridge.start\"); token = (await call(\"bridge.token\")).token; }\n  }));\n  $(\"show-token\").addEventListener(\"click\", () => { showToken = !showToken; render(); });\n  $(\"copy-token\").addEventListener(\"click\", (e) => token && copy(token, e.currentTarget));\n  // Copy buttons always copy the real token, even while it is hidden on screen.\n  $(\"copy-claude\").addEventListener(\"click\", (e) => copy(`claude mcp add --transport http kai ${state.url} --header \"Authorization: Bearer ${token}\"`, e.currentTarget));\n  $(\"copy-json\").addEventListener(\"click\", (e) => copy(JSON.stringify({ mcpServers: { kai: { type: \"http\", url: state.url, headers: { Authorization: `Bearer ${token}` } } } }, null, 2), e.currentTarget));\n  $(\"rotate\").addEventListener(\"click\", () => act(async () => {\n    const ok = window.kai.dialogs\n      ? await window.kai.dialogs.confirm(I.t(\"rotateConfirm\"), { detail: I.t(\"rotateDetail\") })\n      : true;\n    if (ok) token = (await call(\"bridge.rotateToken\")).token;\n  }));\n  $(\"allow-changes\").addEventListener(\"change\", (e) => act(() => call(\"bridge.configure\", { allowChanges: e.target.checked })));\n  $(\"save-port\").addEventListener(\"click\", () => act(() => call(\"bridge.configure\", { port: Number($(\"port\").value) })));\n  $(\"clear\").addEventListener(\"click\", () => act(() => call(\"bridge.clearActivity\")));\n\n  function poll() {\n    clearInterval(timer);\n    if (document.visibilityState === \"visible\") timer = setInterval(refresh, 2000);\n  }\n  document.addEventListener(\"visibilitychange\", () => { poll(); if (document.visibilityState === \"visible\") refresh(); });\n\n  // Follow Core's language. Subscribe before reading so a late read never\n  // overwrites a newer change.\n  let revision = 0;\n  const applyLanguage = (s) => {\n    I.set(s && s.language);\n    document.documentElement.lang = I.language;\n    document.documentElement.dir = (s && s.direction) || \"ltr\";\n    I.apply();\n    render();\n  };\n  const locale = window.kai.locale;\n  if (locale && locale.onChange) {\n    const unsubscribe = locale.onChange((s) => { revision++; applyLanguage(s); });\n    window.addEventListener(\"pagehide\", unsubscribe, { once: true });\n    const initial = revision;\n    locale.get().then((s) => { if (revision === initial) applyLanguage(s); }).catch(() => applyLanguage(null));\n  } else applyLanguage(null);\n\n  refresh();\n  poll();\n})();\n","i18n.js":"\"use strict\";\n// Bundled, offline interface strings for the five languages KAI Core supports.\n// Core owns the language choice; this file only follows it. Missing keys fall\n// back to English. User data, identifiers, URLs and tokens are never translated.\n(function () {\n  const en = {\n    title: \"MCP Bridge\",\n    lede: \"Let AI agents on this computer, such as Claude Code, use KAI through the Model Context Protocol.\",\n    pillOn: \"On\", pillOff: \"Off\", pillError: \"Problem\",\n    stateOn: \"Agents on this computer can connect at the address below.\",\n    stateOff: \"Off. Nothing can connect.\",\n    turnOn: \"Turn on\", turnOff: \"Turn off\",\n    connectTitle: \"Connect an agent\",\n    address: \"Address\", token: \"Access token\",\n    show: \"Show\", hide: \"Hide\", copy: \"Copy\", copied: \"Copied\", save: \"Save\", clear: \"Clear\",\n    tokenHint: \"Anyone with this token can use what you allow below, from this computer. Keep it to yourself.\",\n    claudeCode: \"Claude Code: run this once in a terminal\",\n    otherClients: \"Other MCP clients (HTTP with a header)\",\n    rotate: \"Make a new token\",\n    rotateConfirm: \"Make a new access token?\",\n    rotateDetail: \"Agents using the current token will stop working until you give them the new one.\",\n    accessTitle: \"What agents can use\",\n    accessHint: \"KAI's models and privacy status are always included. Turn on other plugins one by one.\",\n    allowChanges: \"Allow changes\",\n    allowChangesHint: \"Agents can ask to load models, change privacy, save documents, run workflows and similar. You approve every single change in KAI before it happens.\",\n    toolCount: \"{n} tools visible to agents.\",\n    portTitle: \"Port\",\n    portHint: \"The bridge listens on 127.0.0.1 only, so other computers cannot reach it.\",\n    activityTitle: \"Recent activity\",\n    activityHint: \"Only the tool name, time and result are kept, in memory. What agents send and receive is not stored.\",\n    noActivity: \"No calls yet.\",\n    lastClient: \"Last connected: {name} at {time}\",\n    failed: \"failed\",\n    \"src.documents\": \"Documents\", \"src.documents.hint\": \"Read your saved documents.\",\n    \"src.workflows\": \"Workflows\", \"src.workflows.hint\": \"See your workflows and their runs.\",\n    \"src.brain\": \"Brain\", \"src.brain.hint\": \"Search your memories, goals and sources.\",\n    \"src.assistant\": \"Assistant conversations\", \"src.assistant.hint\": \"Assistant asks you each time, unless you share a conversation.\",\n    \"src.code\": \"Koinos Code projects\", \"src.code.hint\": \"Project names only.\",\n    \"src.tools\": \"KAI Tools\", \"src.tools.hint\": \"The names of your tools. Agents cannot run them.\",\n    needPlugin: \"Needs the {name} plugin installed and turned on.\",\n  };\n  const es = {\n    lede: \"Permite que agentes de IA de este ordenador, como Claude Code, usen KAI mediante el Model Context Protocol.\",\n    pillOn: \"Activado\", pillOff: \"Desactivado\", pillError: \"Problema\",\n    stateOn: \"Los agentes de este ordenador pueden conectarse en la dirección de abajo.\",\n    stateOff: \"Desactivado. Nada puede conectarse.\",\n    turnOn: \"Activar\", turnOff: \"Desactivar\",\n    connectTitle: \"Conectar un agente\",\n    address: \"Dirección\", token: \"Token de acceso\",\n    show: \"Mostrar\", hide: \"Ocultar\", copy: \"Copiar\", copied: \"Copiado\", save: \"Guardar\", clear: \"Borrar\",\n    tokenHint: \"Cualquiera con este token puede usar, desde este ordenador, lo que permitas abajo. Guárdalo para ti.\",\n    claudeCode: \"Claude Code: ejecuta esto una vez en una terminal\",\n    otherClients: \"Otros clientes MCP (HTTP con una cabecera)\",\n    rotate: \"Crear un token nuevo\",\n    rotateConfirm: \"¿Crear un token de acceso nuevo?\",\n    rotateDetail: \"Los agentes que usan el token actual dejarán de funcionar hasta que les des el nuevo.\",\n    accessTitle: \"Qué pueden usar los agentes\",\n    accessHint: \"Los modelos de KAI y su estado de privacidad siempre se incluyen. Activa los demás plugins uno a uno.\",\n    allowChanges: \"Permitir cambios\",\n    allowChangesHint: \"Los agentes pueden pedir cargar modelos, cambiar la privacidad, guardar documentos, ejecutar flujos y similares. Apruebas cada cambio en KAI antes de que ocurra.\",\n    toolCount: \"{n} herramientas visibles para los agentes.\",\n    portTitle: \"Puerto\",\n    portHint: \"El puente solo escucha en 127.0.0.1, así que otros ordenadores no pueden llegar a él.\",\n    activityTitle: \"Actividad reciente\",\n    activityHint: \"Solo se guardan en memoria el nombre de la herramienta, la hora y el resultado. Lo que los agentes envían y reciben no se guarda.\",\n    noActivity: \"Aún no hay llamadas.\",\n    lastClient: \"Última conexión: {name} a las {time}\",\n    failed: \"falló\",\n    \"src.documents\": \"Documentos\", \"src.documents.hint\": \"Leer tus documentos guardados.\",\n    \"src.workflows\": \"Flujos de trabajo\", \"src.workflows.hint\": \"Ver tus flujos y sus ejecuciones.\",\n    \"src.brain\": \"Brain\", \"src.brain.hint\": \"Buscar en tus recuerdos, objetivos y fuentes.\",\n    \"src.assistant\": \"Conversaciones del Asistente\", \"src.assistant.hint\": \"El Asistente te pregunta cada vez, salvo que compartas una conversación.\",\n    \"src.code\": \"Proyectos de Koinos Code\", \"src.code.hint\": \"Solo los nombres de los proyectos.\",\n    \"src.tools\": \"KAI Tools\", \"src.tools.hint\": \"Los nombres de tus herramientas. Los agentes no pueden ejecutarlas.\",\n    needPlugin: \"Necesita el plugin {name} instalado y activado.\",\n  };\n  const ptBR = {\n    lede: \"Permite que agentes de IA deste computador, como o Claude Code, usem o KAI pelo Model Context Protocol.\",\n    pillOn: \"Ligado\", pillOff: \"Desligado\", pillError: \"Problema\",\n    stateOn: \"Agentes deste computador podem se conectar no endereço abaixo.\",\n    stateOff: \"Desligado. Nada pode se conectar.\",\n    turnOn: \"Ligar\", turnOff: \"Desligar\",\n    connectTitle: \"Conectar um agente\",\n    address: \"Endereço\", token: \"Token de acesso\",\n    show: \"Mostrar\", hide: \"Ocultar\", copy: \"Copiar\", copied: \"Copiado\", save: \"Salvar\", clear: \"Limpar\",\n    tokenHint: \"Quem tiver este token pode usar, a partir deste computador, o que você permitir abaixo. Guarde-o só para você.\",\n    claudeCode: \"Claude Code: execute isto uma vez em um terminal\",\n    otherClients: \"Outros clientes MCP (HTTP com um cabeçalho)\",\n    rotate: \"Criar um token novo\",\n    rotateConfirm: \"Criar um novo token de acesso?\",\n    rotateDetail: \"Os agentes que usam o token atual vão parar de funcionar até você passar o novo.\",\n    accessTitle: \"O que os agentes podem usar\",\n    accessHint: \"Os modelos do KAI e o status de privacidade estão sempre incluídos. Ative os outros plugins um a um.\",\n    allowChanges: \"Permitir alterações\",\n    allowChangesHint: \"Os agentes podem pedir para carregar modelos, mudar a privacidade, salvar documentos, executar fluxos e afins. Você aprova cada alteração no KAI antes que aconteça.\",\n    toolCount: \"{n} ferramentas visíveis para os agentes.\",\n    portTitle: \"Porta\",\n    portHint: \"A ponte escuta apenas em 127.0.0.1, então outros computadores não conseguem alcançá-la.\",\n    activityTitle: \"Atividade recente\",\n    activityHint: \"Só o nome da ferramenta, a hora e o resultado ficam guardados, na memória. O que os agentes enviam e recebem não é armazenado.\",\n    noActivity: \"Nenhuma chamada ainda.\",\n    lastClient: \"Última conexão: {name} às {time}\",\n    failed: \"falhou\",\n    \"src.documents\": \"Documentos\", \"src.documents.hint\": \"Ler seus documentos salvos.\",\n    \"src.workflows\": \"Fluxos de trabalho\", \"src.workflows.hint\": \"Ver seus fluxos e suas execuções.\",\n    \"src.brain\": \"Brain\", \"src.brain.hint\": \"Pesquisar suas memórias, metas e fontes.\",\n    \"src.assistant\": \"Conversas do Assistente\", \"src.assistant.hint\": \"O Assistente pergunta toda vez, a menos que você compartilhe uma conversa.\",\n    \"src.code\": \"Projetos do Koinos Code\", \"src.code.hint\": \"Apenas os nomes dos projetos.\",\n    \"src.tools\": \"KAI Tools\", \"src.tools.hint\": \"Os nomes das suas ferramentas. Os agentes não podem executá-las.\",\n    needPlugin: \"Requer o plugin {name} instalado e ativado.\",\n  };\n  const fr = {\n    lede: \"Permet aux agents d’IA de cet ordinateur, comme Claude Code, d’utiliser KAI via le Model Context Protocol.\",\n    pillOn: \"Activé\", pillOff: \"Désactivé\", pillError: \"Problème\",\n    stateOn: \"Les agents de cet ordinateur peuvent se connecter à l’adresse ci-dessous.\",\n    stateOff: \"Désactivé. Rien ne peut se connecter.\",\n    turnOn: \"Activer\", turnOff: \"Désactiver\",\n    connectTitle: \"Connecter un agent\",\n    address: \"Adresse\", token: \"Jeton d’accès\",\n    show: \"Afficher\", hide: \"Masquer\", copy: \"Copier\", copied: \"Copié\", save: \"Enregistrer\", clear: \"Effacer\",\n    tokenHint: \"Toute personne disposant de ce jeton peut utiliser, depuis cet ordinateur, ce que vous autorisez ci-dessous. Gardez-le pour vous.\",\n    claudeCode: \"Claude Code : exécutez ceci une fois dans un terminal\",\n    otherClients: \"Autres clients MCP (HTTP avec un en-tête)\",\n    rotate: \"Créer un nouveau jeton\",\n    rotateConfirm: \"Créer un nouveau jeton d’accès ?\",\n    rotateDetail: \"Les agents qui utilisent le jeton actuel cesseront de fonctionner jusqu’à ce que vous leur donniez le nouveau.\",\n    accessTitle: \"Ce que les agents peuvent utiliser\",\n    accessHint: \"Les modèles de KAI et son état de confidentialité sont toujours inclus. Activez les autres plugins un par un.\",\n    allowChanges: \"Autoriser les modifications\",\n    allowChangesHint: \"Les agents peuvent demander à charger des modèles, changer la confidentialité, enregistrer des documents, lancer des workflows, etc. Vous approuvez chaque modification dans KAI avant qu’elle n’ait lieu.\",\n    toolCount: \"{n} outils visibles par les agents.\",\n    portTitle: \"Port\",\n    portHint: \"Le pont n’écoute que sur 127.0.0.1 : les autres ordinateurs ne peuvent pas l’atteindre.\",\n    activityTitle: \"Activité récente\",\n    activityHint: \"Seuls le nom de l’outil, l’heure et le résultat sont conservés, en mémoire. Ce que les agents envoient et reçoivent n’est pas enregistré.\",\n    noActivity: \"Aucun appel pour l’instant.\",\n    lastClient: \"Dernière connexion : {name} à {time}\",\n    failed: \"échec\",\n    \"src.documents\": \"Documents\", \"src.documents.hint\": \"Lire vos documents enregistrés.\",\n    \"src.workflows\": \"Workflows\", \"src.workflows.hint\": \"Voir vos workflows et leurs exécutions.\",\n    \"src.brain\": \"Brain\", \"src.brain.hint\": \"Chercher dans vos souvenirs, objectifs et sources.\",\n    \"src.assistant\": \"Conversations de l’Assistant\", \"src.assistant.hint\": \"L’Assistant vous demande à chaque fois, sauf si vous partagez une conversation.\",\n    \"src.code\": \"Projets Koinos Code\", \"src.code.hint\": \"Noms des projets uniquement.\",\n    \"src.tools\": \"KAI Tools\", \"src.tools.hint\": \"Les noms de vos outils. Les agents ne peuvent pas les exécuter.\",\n    needPlugin: \"Nécessite le plugin {name} installé et activé.\",\n  };\n  const de = {\n    lede: \"Lässt KI-Agenten auf diesem Computer, etwa Claude Code, KAI über das Model Context Protocol nutzen.\",\n    pillOn: \"An\", pillOff: \"Aus\", pillError: \"Problem\",\n    stateOn: \"Agenten auf diesem Computer können sich unter der Adresse unten verbinden.\",\n    stateOff: \"Aus. Nichts kann sich verbinden.\",\n    turnOn: \"Einschalten\", turnOff: \"Ausschalten\",\n    connectTitle: \"Einen Agenten verbinden\",\n    address: \"Adresse\", token: \"Zugriffstoken\",\n    show: \"Anzeigen\", hide: \"Verbergen\", copy: \"Kopieren\", copied: \"Kopiert\", save: \"Speichern\", clear: \"Leeren\",\n    tokenHint: \"Wer dieses Token hat, kann von diesem Computer aus nutzen, was Sie unten erlauben. Behalten Sie es für sich.\",\n    claudeCode: \"Claude Code: einmal in einem Terminal ausführen\",\n    otherClients: \"Andere MCP-Clients (HTTP mit Header)\",\n    rotate: \"Neues Token erstellen\",\n    rotateConfirm: \"Ein neues Zugriffstoken erstellen?\",\n    rotateDetail: \"Agenten mit dem aktuellen Token funktionieren nicht mehr, bis Sie ihnen das neue geben.\",\n    accessTitle: \"Was Agenten nutzen dürfen\",\n    accessHint: \"Die Modelle von KAI und der Datenschutzstatus sind immer dabei. Schalten Sie andere Plugins einzeln frei.\",\n    allowChanges: \"Änderungen erlauben\",\n    allowChangesHint: \"Agenten können anfragen, Modelle zu laden, den Datenschutz zu ändern, Dokumente zu speichern, Workflows zu starten und Ähnliches. Sie bestätigen jede einzelne Änderung in KAI, bevor sie passiert.\",\n    toolCount: \"{n} Werkzeuge für Agenten sichtbar.\",\n    portTitle: \"Port\",\n    portHint: \"Die Brücke lauscht nur auf 127.0.0.1, andere Computer erreichen sie nicht.\",\n    activityTitle: \"Letzte Aktivität\",\n    activityHint: \"Nur Werkzeugname, Zeit und Ergebnis werden im Arbeitsspeicher gehalten. Was Agenten senden und empfangen, wird nicht gespeichert.\",\n    noActivity: \"Noch keine Aufrufe.\",\n    lastClient: \"Zuletzt verbunden: {name} um {time}\",\n    failed: \"fehlgeschlagen\",\n    \"src.documents\": \"Dokumente\", \"src.documents.hint\": \"Ihre gespeicherten Dokumente lesen.\",\n    \"src.workflows\": \"Workflows\", \"src.workflows.hint\": \"Ihre Workflows und deren Läufe sehen.\",\n    \"src.brain\": \"Brain\", \"src.brain.hint\": \"In Ihren Erinnerungen, Zielen und Quellen suchen.\",\n    \"src.assistant\": \"Assistent-Unterhaltungen\", \"src.assistant.hint\": \"Der Assistent fragt jedes Mal, außer Sie teilen eine Unterhaltung.\",\n    \"src.code\": \"Koinos-Code-Projekte\", \"src.code.hint\": \"Nur Projektnamen.\",\n    \"src.tools\": \"KAI Tools\", \"src.tools.hint\": \"Die Namen Ihrer Werkzeuge. Agenten können sie nicht ausführen.\",\n    needPlugin: \"Benötigt das installierte und eingeschaltete Plugin {name}.\",\n  };\n  const catalogs = { en, es, \"pt-BR\": ptBR, fr, de };\n  let language = \"en\";\n  function t(key, params) {\n    const s = (catalogs[language] && catalogs[language][key]) ?? en[key] ?? key;\n    return params ? s.replace(/\\{(\\w+)\\}/g, (_, k) => (params[k] ?? \"\")) : s;\n  }\n  window.MCPBridgeI18n = {\n    t,\n    get language() { return language; },\n    set(lang) { language = Object.hasOwn(catalogs, lang) ? lang : \"en\"; },\n    apply(root = document) {\n      for (const el of root.querySelectorAll(\"[data-i18n]\")) el.textContent = t(el.dataset.i18n);\n    },\n  };\n})();\n","index.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>MCP Bridge</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"i18n.js\" defer></script>\n  <script src=\"app.js\" defer></script>\n</head>\n<body>\n  <main>\n    <header class=\"top\">\n      <div>\n        <h1 data-i18n=\"title\">MCP Bridge</h1>\n        <p class=\"lede\" data-i18n=\"lede\">Let AI agents on this computer, such as Claude Code, use KAI through the Model Context Protocol.</p>\n      </div>\n      <span id=\"pill\" class=\"pill pill-off\" role=\"status\" aria-live=\"polite\">—</span>\n    </header>\n\n    <section class=\"card\">\n      <div class=\"row\">\n        <p id=\"state-text\" class=\"state\">—</p>\n        <button id=\"toggle\" type=\"button\" class=\"primary\">—</button>\n      </div>\n      <p id=\"error\" class=\"error\" role=\"alert\" hidden></p>\n    </section>\n\n    <section class=\"card\" id=\"connect\" hidden>\n      <h2 data-i18n=\"connectTitle\">Connect an agent</h2>\n      <label class=\"field\">\n        <span data-i18n=\"address\">Address</span>\n        <input id=\"url\" type=\"text\" readonly>\n      </label>\n      <label class=\"field\">\n        <span data-i18n=\"token\">Access token</span>\n        <span class=\"inline\">\n          <input id=\"token\" type=\"password\" readonly autocomplete=\"off\">\n          <button id=\"show-token\" type=\"button\" data-i18n=\"show\">Show</button>\n          <button id=\"copy-token\" type=\"button\" data-i18n=\"copy\">Copy</button>\n        </span>\n      </label>\n      <p class=\"hint\" data-i18n=\"tokenHint\">Anyone with this token can use what you allow below, from this computer. Keep it to yourself.</p>\n      <label class=\"field\">\n        <span data-i18n=\"claudeCode\">Claude Code: run this once in a terminal</span>\n        <textarea id=\"cmd-claude\" rows=\"3\" readonly></textarea>\n        <button id=\"copy-claude\" type=\"button\" data-i18n=\"copy\">Copy</button>\n      </label>\n      <label class=\"field\">\n        <span data-i18n=\"otherClients\">Other MCP clients (HTTP with a header)</span>\n        <textarea id=\"cmd-json\" rows=\"8\" readonly></textarea>\n        <button id=\"copy-json\" type=\"button\" data-i18n=\"copy\">Copy</button>\n      </label>\n      <button id=\"rotate\" type=\"button\" class=\"quiet\" data-i18n=\"rotate\">Make a new token</button>\n    </section>\n\n    <section class=\"card\">\n      <h2 data-i18n=\"accessTitle\">What agents can use</h2>\n      <p class=\"hint\" data-i18n=\"accessHint\">KAI's models and privacy status are always included. Turn on other plugins one by one.</p>\n      <div id=\"sources\" class=\"checks\"></div>\n      <label class=\"check strong\">\n        <input id=\"allow-changes\" type=\"checkbox\">\n        <span>\n          <strong data-i18n=\"allowChanges\">Allow changes</strong>\n          <small data-i18n=\"allowChangesHint\">Agents can ask to load models, change privacy, save documents, run workflows and similar. You approve every single change in KAI before it happens.</small>\n        </span>\n      </label>\n      <p class=\"hint\" id=\"tool-count\"></p>\n    </section>\n\n    <section class=\"card\">\n      <h2 data-i18n=\"portTitle\">Port</h2>\n      <div class=\"inline\">\n        <input id=\"port\" type=\"number\" min=\"1024\" max=\"65535\" inputmode=\"numeric\">\n        <button id=\"save-port\" type=\"button\" data-i18n=\"save\">Save</button>\n      </div>\n      <p class=\"hint\" data-i18n=\"portHint\">The bridge listens on 127.0.0.1 only, so other computers cannot reach it.</p>\n    </section>\n\n    <section class=\"card\">\n      <div class=\"row\">\n        <h2 data-i18n=\"activityTitle\">Recent activity</h2>\n        <button id=\"clear\" type=\"button\" class=\"quiet\" data-i18n=\"clear\">Clear</button>\n      </div>\n      <p id=\"client\" class=\"hint\"></p>\n      <ol id=\"activity\" class=\"activity\"></ol>\n      <p class=\"hint\" data-i18n=\"activityHint\">Only the tool name, time and result are kept, in memory. What agents send and receive is not stored.</p>\n    </section>\n  </main>\n</body>\n</html>\n","service/index.js":"\"use strict\";\n/*\n * MCP Bridge — native service.\n *\n * Lets AI agents on this computer (Claude Code, Claude Desktop, Cursor, any\n * MCP client) use KAI through the Model Context Protocol.\n *\n * Consent model:\n *   - Installing the plugin starts nothing. The local endpoint runs only after\n *     the user presses Turn on, and startBackground() resumes only that\n *     explicit choice.\n *   - Read access to other plugins is off per source until ticked.\n *   - Changes are hidden until \"Allow changes\" is ticked, and even then every\n *     change is approved by a person in the KAI window (see tools.js).\n *   - The token is generated here, stored encrypted with the OS secret store,\n *     and shown only in this plugin's own window.\n *   - Tool arguments and results are never logged or persisted; the activity\n *     list keeps tool name, time, duration and success only, in memory.\n */\nconst crypto = require(\"node:crypto\");\nconst { startMcpServer } = require(\"./mcp-http\");\nconst { tools, visibleTools, annotations, SOURCES } = require(\"./tools\");\n\nconst DEFAULT_PORT = 41111;\nconst ACTIVITY_MAX = 100;\nconst SOURCE_KEYS = Object.keys(SOURCES).filter((k) => k !== \"core\");\n\nconst INSTRUCTIONS =\n  \"You are connected to KAI (KAI Core Beta) on the user's own computer through the MCP Bridge plugin. \" +\n  \"Start with kai_status. Changes are approved by the user in the KAI window: if a change comes back \" +\n  \"'not approved', tell the user and do not retry it unasked. For local model inference, use KAI's \" +\n  \"OpenAI-compatible API at http://127.0.0.1:41100/v1 directly.\";\n\nfunction create(api) {\n  if (api.version !== 1) throw Error(\"MCP Bridge requires KAI Foundation API v1\");\n  let closed = false;\n  let server = null;\n  let starting = null;\n  let lastError = null;\n  let lastClient = null;\n  const activity = [];\n\n  const alive = (signal) => {\n    if (closed) throw Error(\"MCP Bridge is closed\");\n    api.signal.throwIfAborted();\n    signal?.throwIfAborted();\n  };\n\n  // ----- settings -----\n  const port = () => {\n    const p = api.settings.get(\"port\", DEFAULT_PORT);\n    return Number.isInteger(p) && p >= 1024 && p <= 65535 ? p : DEFAULT_PORT;\n  };\n  const allowChanges = () => api.settings.get(\"allowChanges\", false) === true;\n  const sources = () => {\n    const saved = api.settings.get(\"sources\", {}) || {};\n    return Object.fromEntries(SOURCE_KEYS.map((k) => [k, saved[k] === true]));\n  };\n\n  // ----- token: random, encrypted at rest with the OS secret store -----\n  let tokenCache = null;\n  function requireEncryption() {\n    if (!api.secrets.isEncryptionAvailable()) {\n      throw Error(\"This computer has no secure storage available for the bridge's access token, so MCP Bridge cannot be turned on.\");\n    }\n  }\n  function newToken() {\n    requireEncryption();\n    const token = \"kai_mcp_\" + crypto.randomBytes(32).toString(\"base64url\");\n    api.settings.set(\"token\", Buffer.from(api.secrets.encryptString(token)).toString(\"base64\"));\n    tokenCache = token;\n    return token;\n  }\n  function token() {\n    if (tokenCache) return tokenCache;\n    const saved = api.settings.get(\"token\", null);\n    if (typeof saved !== \"string\" || !saved) return null;\n    try {\n      tokenCache = api.secrets.decryptString(Buffer.from(saved, \"base64\"));\n      return tokenCache;\n    } catch {\n      return null; // unreadable (e.g. OS keychain reset) — a new one is made on Turn on\n    }\n  }\n\n  // ----- tool execution -----\n  function record(entry) {\n    activity.unshift(entry);\n    if (activity.length > ACTIVITY_MAX) activity.length = ACTIVITY_MAX;\n  }\n\n  async function approve(title, detail) {\n    const ok = await api.desktop.confirm(`MCP Bridge: ${title}`, `An AI agent connected through MCP Bridge wants to do this:\\n\\n${detail}`);\n    if (!ok) {\n      throw Error(\"Not approved in KAI. The user declined, or the KAI window was hidden (approvals need it open). Tell the user; do not retry unasked.\");\n    }\n  }\n\n  function listTools() {\n    return visibleTools({ sources: sources(), allowChanges: allowChanges() }).map((t) => ({\n      name: t.name,\n      description: t.description,\n      inputSchema: t.inputSchema,\n      annotations: annotations(t),\n    }));\n  }\n\n  async function callTool(name, args, requestSignal) {\n    const started = Date.now();\n    const visible = visibleTools({ sources: sources(), allowChanges: allowChanges() });\n    const tool = visible.find((t) => t.name === name);\n    if (!tool) {\n      const known = tools.find((t) => t.name === name);\n      const why = !known\n        ? `Unknown tool: ${name}`\n        : known.mutating && !allowChanges()\n          ? `\"${name}\" makes changes, and the user has not ticked \"Allow changes\" in MCP Bridge.`\n          : `\"${name}\" needs the ${SOURCES[known.source].label} source, which is off in MCP Bridge.`;\n      record({ at: started, tool: String(name).slice(0, 64), ok: false, ms: 0, error: \"unavailable\" });\n      return { content: [{ type: \"text\", text: why }], isError: true };\n    }\n    const signal = AbortSignal.any([api.signal, requestSignal]);\n    const ctx = {\n      api,\n      signal,\n      sources: sources(),\n      allowChanges: allowChanges(),\n      call: (service, method, input) => api.services.call(service, method, input, { signal }),\n    };\n    try {\n      alive(signal);\n      if (tool.approval === \"bridge\") {\n        const { title, detail } = tool.confirm(args);\n        await approve(title, detail);\n        alive(signal);\n      }\n      const result = await tool.handler(ctx, args);\n      record({ at: started, tool: name, ok: true, ms: Date.now() - started });\n      return { content: [{ type: \"text\", text: JSON.stringify(result ?? null, null, 2) }] };\n    } catch (error) {\n      record({ at: started, tool: name, ok: false, ms: Date.now() - started, error: \"failed\" });\n      return { content: [{ type: \"text\", text: String(error?.message ?? error) }], isError: true };\n    }\n  }\n\n  // ----- listener lifecycle -----\n  async function start() {\n    alive();\n    if (server) return status();\n    if (starting) { await starting; return status(); }\n    starting = (async () => {\n      if (!token()) newToken();\n      try {\n        server = await startMcpServer({\n          port: port(),\n          getToken: token,\n          info: { name: \"kai-mcp-bridge\", title: \"KAI MCP Bridge\", version: api.plugin.version },\n          instructions: INSTRUCTIONS,\n          listTools,\n          callTool,\n          onClient: (client) => { lastClient = { ...client, at: Date.now() }; },\n        });\n        lastError = null;\n        if (closed) { await server.close(); server = null; }\n        else api.log(\"info\", `MCP Bridge listening on 127.0.0.1:${server.port}`);\n      } catch (error) {\n        server = null;\n        lastError = error?.code === \"EADDRINUSE\"\n          ? `Port ${port()} is already in use on this computer. Choose another port.`\n          : `Could not start: ${error?.message ?? error}`;\n        api.log(\"warn\", lastError);\n        throw Error(lastError);\n      }\n    })();\n    try { await starting; } finally { starting = null; }\n    return status();\n  }\n\n  async function stop() {\n    if (starting) await starting.catch(() => {});\n    const s = server;\n    server = null;\n    if (s) { await s.close(); api.log(\"info\", \"MCP Bridge stopped\"); }\n  }\n\n  function status() {\n    const p = server?.port ?? port();\n    let encryption = false;\n    try { encryption = api.secrets.isEncryptionAvailable(); } catch { /* reported as false */ }\n    return {\n      version: api.plugin.version,\n      running: !!server,\n      enabled: api.settings.get(\"enabled\", false) === true,\n      port: p,\n      url: `http://127.0.0.1:${p}/mcp`,\n      allowChanges: allowChanges(),\n      sources: sources(),\n      sourceLabels: Object.fromEntries(SOURCE_KEYS.map((k) => [k, SOURCES[k].label])),\n      toolCount: visibleTools({ sources: sources(), allowChanges: allowChanges() }).length,\n      hasToken: !!token(),\n      encryption,\n      lastError,\n      lastClient,\n      activity: activity.slice(0, 30),\n    };\n  }\n\n  // ----- the bridge window's own methods -----\n  async function configure(input = {}) {\n    if (input.port !== undefined) {\n      if (!Number.isInteger(input.port) || input.port < 1024 || input.port > 65535) throw Error(\"Choose a port between 1024 and 65535.\");\n      const changed = input.port !== port();\n      api.settings.set(\"port\", input.port);\n      if (changed && server) { await stop(); await start(); }\n    }\n    if (input.allowChanges !== undefined) {\n      if (typeof input.allowChanges !== \"boolean\") throw Error(\"allowChanges must be true or false\");\n      api.settings.set(\"allowChanges\", input.allowChanges);\n    }\n    if (input.sources !== undefined) {\n      if (!input.sources || typeof input.sources !== \"object\" || Array.isArray(input.sources)) throw Error(\"sources must be an object\");\n      const next = sources();\n      for (const [key, value] of Object.entries(input.sources)) {\n        if (!SOURCE_KEYS.includes(key) || typeof value !== \"boolean\") throw Error(`Unknown source setting: ${key}`);\n        next[key] = value;\n      }\n      api.settings.set(\"sources\", next);\n    }\n    return status();\n  }\n\n  function dispose() {\n    if (closed) return;\n    closed = true;\n    api.signal.removeEventListener(\"abort\", dispose);\n    return stop();\n  }\n  api.signal.addEventListener(\"abort\", dispose, { once: true });\n\n  return {\n    async call(method, input, signal) {\n      alive(signal);\n      switch (method) {\n        case \"bridge.status\":\n          return status();\n        case \"bridge.start\":\n          api.settings.set(\"enabled\", true);\n          return start();\n        case \"bridge.stop\":\n          api.settings.set(\"enabled\", false);\n          await stop();\n          return status();\n        case \"bridge.configure\":\n          return configure(input || {});\n        case \"bridge.token\": {\n          const t = token();\n          return { token: t };\n        }\n        case \"bridge.rotateToken\":\n          newToken(); // existing clients stop working at once\n          return { ...status(), token: token() };\n        case \"bridge.clearActivity\":\n          activity.length = 0;\n          return status();\n        default:\n          throw Error(\"Unknown MCP Bridge operation\");\n      }\n    },\n    // Resume only what the user explicitly switched on. A failure here must\n    // not take the plugin down — it is shown in the bridge window instead.\n    async startBackground() {\n      alive();\n      if (api.settings.get(\"enabled\", false) === true) await start().catch(() => {});\n    },\n    dispose,\n  };\n}\n\nmodule.exports = { create, DEFAULT_PORT };\n","service/mcp-http.js":"\"use strict\";\n/*\n * A minimal, dependency-free MCP server over Streamable HTTP (JSON responses,\n * stateless — no sessions, no server-initiated streams). Scope: initialize,\n * ping, tools/list, tools/call. That is all an agent needs to use KAI's tools.\n *\n * Exposure rules, checked in this order on every request:\n *   1. Bound to 127.0.0.1 only. Nothing on the LAN can connect.\n *   2. Host must be this loopback port (DNS-rebinding guard, as Core does).\n *   3. Any request carrying an Origin header is refused: browsers send one,\n *      local MCP clients don't. A web page can never drive the bridge.\n *   4. POST /mcp only.\n *   5. Authorization: Bearer <token>, compared in constant time.\n */\nconst http = require(\"node:http\");\nconst crypto = require(\"node:crypto\");\n\nconst SUPPORTED_VERSIONS = [\"2025-06-18\", \"2025-03-26\", \"2024-11-05\"];\nconst MAX_BODY = 1024 * 1024;\nconst MAX_CONCURRENT_CALLS = 4;\n\nconst rpcError = (id, code, message) => ({ jsonrpc: \"2.0\", id: id ?? null, error: { code, message } });\nconst rpcResult = (id, result) => ({ jsonrpc: \"2.0\", id, result });\n\nfunction tokenMatches(header, token) {\n  const m = /^Bearer\\s+(.+)$/i.exec(String(header || \"\"));\n  if (!m || !token) return false;\n  const a = crypto.createHash(\"sha256\").update(m[1].trim()).digest();\n  const b = crypto.createHash(\"sha256\").update(token).digest();\n  return crypto.timingSafeEqual(a, b);\n}\n\n/**\n * startMcpServer({ port, getToken, info, listTools, callTool, onActivity })\n *   listTools()                    → [{ name, description, inputSchema, annotations }]\n *   callTool(name, args, signal)   → { content, isError? }   (never throws)\n *   onActivity({ client })         ← initialize seen\n * Resolves to { port, close() } once listening.\n */\nfunction startMcpServer({ port, getToken, info, instructions, listTools, callTool, onClient = () => {} }) {\n  let active = 0;\n  const sockets = new Set();\n\n  const server = http.createServer((req, res) => {\n    handle(req, res).catch(() => {\n      if (!res.headersSent) send(res, 500, rpcError(null, -32603, \"Internal error\"));\n      else res.destroy();\n    });\n  });\n  server.on(\"connection\", (socket) => { sockets.add(socket); socket.on(\"close\", () => sockets.delete(socket)); });\n  server.requestTimeout = 15 * 60 * 1000; // a workflow run or model load can take a while\n  server.headersTimeout = 30 * 1000;\n\n  function send(res, status, body, headers = {}) {\n    const payload = body === undefined ? \"\" : JSON.stringify(body);\n    res.writeHead(status, {\n      ...(payload ? { \"content-type\": \"application/json\" } : {}),\n      \"cache-control\": \"no-store\",\n      \"x-content-type-options\": \"nosniff\",\n      ...headers,\n    });\n    res.end(payload);\n  }\n\n  async function readBody(req) {\n    const chunks = [];\n    let size = 0;\n    for await (const chunk of req) {\n      size += chunk.length;\n      if (size > MAX_BODY) throw Object.assign(Error(\"too large\"), { status: 413 });\n      chunks.push(chunk);\n    }\n    return Buffer.concat(chunks).toString(\"utf8\");\n  }\n\n  async function handle(req, res) {\n    const p = server.address()?.port ?? port;\n    const hosts = new Set([`127.0.0.1:${p}`, `localhost:${p}`, `[::1]:${p}`]);\n    if (!hosts.has(String(req.headers.host || \"\").toLowerCase())) {\n      return send(res, 403, { error: \"Refused: use the local address and port shown in MCP Bridge.\" });\n    }\n    if (req.headers.origin !== undefined) {\n      return send(res, 403, { error: \"Refused: MCP Bridge does not answer web pages.\" });\n    }\n    const path = String(req.url || \"\").split(\"?\")[0];\n    if (path !== \"/mcp\") return send(res, 404, { error: \"Not found\" });\n    if (req.method !== \"POST\") return send(res, 405, { error: \"Use POST\" }, { allow: \"POST\" });\n    if (!tokenMatches(req.headers.authorization, getToken())) {\n      return send(res, 401, { error: \"A valid bearer token is required. Copy it from MCP Bridge in KAI.\" }, { \"www-authenticate\": 'Bearer realm=\"kai-mcp-bridge\"' });\n    }\n\n    let raw;\n    try { raw = await readBody(req); }\n    catch (e) { return send(res, e.status || 400, rpcError(null, -32600, e.status === 413 ? \"Request too large\" : \"Unreadable request\")); }\n    let message;\n    try { message = JSON.parse(raw); }\n    catch { return send(res, 400, rpcError(null, -32700, \"Parse error\")); }\n\n    // Cancel tool work if the client goes away before we answer.\n    const controller = new AbortController();\n    res.on(\"close\", () => { if (!res.writableFinished) controller.abort(Error(\"Client disconnected\")); });\n\n    const batch = Array.isArray(message);\n    const messages = batch ? message : [message];\n    if (!messages.length) return send(res, 400, rpcError(null, -32600, \"Empty batch\"));\n    const replies = [];\n    for (const m of messages) {\n      const reply = await dispatch(m, controller.signal);\n      if (reply) replies.push(reply);\n    }\n    if (!replies.length) return send(res, 202);\n    return send(res, 200, batch ? replies : replies[0]);\n  }\n\n  async function dispatch(m, signal) {\n    if (!m || typeof m !== \"object\" || m.jsonrpc !== \"2.0\" || typeof m.method !== \"string\") {\n      return rpcError(m?.id, -32600, \"Invalid request\");\n    }\n    const isNotification = m.id === undefined || m.id === null;\n    if (isNotification) return null; // notifications/initialized, cancelled, …\n\n    switch (m.method) {\n      case \"initialize\": {\n        const asked = m.params?.protocolVersion;\n        const ci = m.params?.clientInfo;\n        if (ci && typeof ci.name === \"string\") onClient({ name: ci.name.slice(0, 80), version: String(ci.version ?? \"\").slice(0, 40) });\n        return rpcResult(m.id, {\n          protocolVersion: SUPPORTED_VERSIONS.includes(asked) ? asked : SUPPORTED_VERSIONS[0],\n          capabilities: { tools: { listChanged: false } },\n          serverInfo: info,\n          ...(instructions ? { instructions } : {}),\n        });\n      }\n      case \"ping\":\n        return rpcResult(m.id, {});\n      case \"tools/list\":\n        return rpcResult(m.id, { tools: listTools() });\n      case \"tools/call\": {\n        const name = m.params?.name;\n        const args = m.params?.arguments ?? {};\n        if (typeof name !== \"string\") return rpcError(m.id, -32602, \"tools/call needs a tool name\");\n        if (typeof args !== \"object\" || Array.isArray(args)) return rpcError(m.id, -32602, \"arguments must be an object\");\n        if (active >= MAX_CONCURRENT_CALLS) {\n          return rpcResult(m.id, { content: [{ type: \"text\", text: \"MCP Bridge is busy with other calls; try again shortly.\" }], isError: true });\n        }\n        active++;\n        try { return rpcResult(m.id, await callTool(name, args, signal)); }\n        finally { active--; }\n      }\n      default:\n        return rpcError(m.id, -32601, `Method not found: ${m.method}`);\n    }\n  }\n\n  return new Promise((resolve, reject) => {\n    server.once(\"error\", reject);\n    server.listen(port, \"127.0.0.1\", () => {\n      server.off(\"error\", reject);\n      resolve({\n        port: server.address().port,\n        close: () => new Promise((done) => {\n          for (const socket of sockets) socket.destroy();\n          server.close(() => done());\n        }),\n      });\n    });\n  });\n}\n\nmodule.exports = { startMcpServer, tokenMatches, SUPPORTED_VERSIONS };\n","service/tools.js":"\"use strict\";\n/*\n * The tools an external AI agent sees. Every tool belongs to a source:\n *\n *   core       — Foundation itself (models, runtime, privacy). On whenever\n *                the bridge is on.\n *   documents / workflows / brain / assistant / code / tools\n *              — another installed plugin, reached over Core's local service\n *                bus. Each source is OFF until the user ticks it in the\n *                bridge's own window.\n *\n * Mutating tools are hidden unless the user ticks \"Allow changes\", and every\n * one is approved by a person in the KAI window — never by the agent:\n *\n *   approval \"core\"     — Foundation shows its own review (models.ensure,\n *                         network.configure).\n *   approval \"provider\" — the owning plugin shows its own dialog (Workflows\n *                         run, Brain remember/forget, Documents remove,\n *                         Assistant sharing).\n *   approval \"bridge\"   — the provider has no dialog for this operation, so\n *                         the bridge asks with api.desktop.confirm first.\n *\n * Deliberately NOT wrapped at any setting: kai.tools call/payment (generic\n * tool execution and paid runs), everything in kai.connections (email,\n * calendar and third-party account actions), Brain tool/context/sync/source\n * (tool execution and network fetches), Assistant chat writes, wallet and\n * credit operations, account requests, and the Core settings that move\n * money or re-point the node. A test greps this file to keep it that way.\n */\n\nconst SOURCES = {\n  core: { service: null, label: \"KAI Core\" },\n  documents: { service: \"kai.documents\", label: \"Documents\" },\n  workflows: { service: \"kai.workflows\", label: \"Workflows\" },\n  brain: { service: \"kai.brain\", label: \"Brain\" },\n  assistant: { service: \"kai.assistant\", label: \"Assistant conversations\" },\n  code: { service: \"kai.code\", label: \"Koinos Code projects\" },\n  tools: { service: \"kai.tools\", label: \"KAI Tools (list only)\" },\n};\n\nconst PRIVACY_MODES = [\"local-only\", \"local-first\", \"network\"];\n\nconst obj = (properties = {}, required = []) => ({\n  type: \"object\",\n  properties,\n  ...(required.length ? { required } : {}),\n  additionalProperties: false,\n});\nconst str = (description, extra = {}) => ({ type: \"string\", description, ...extra });\n\nfunction text(value, name, max) {\n  if (typeof value !== \"string\" || !value.trim()) throw Error(`Missing required argument: ${name} (non-empty string)`);\n  if (value.length > max) throw Error(`${name} is ${value.length} characters; the limit is ${max}`);\n  return value;\n}\nfunction id(value, name = \"id\") {\n  if (typeof value !== \"string\" || !/^[A-Za-z0-9_.:-]{1,200}$/.test(value)) throw Error(`Missing or invalid argument: ${name}`);\n  return value;\n}\n\n// Through the service bus: Core resolves the provider, starts it if needed,\n// and refuses with \"Install and enable a plugin providing …\" when absent.\nconst via = (source, method, input = {}) => (ctx) => ctx.call(SOURCES[source].service, method, input);\n\nconst tools = [\n  // ----- core -----\n  {\n    name: \"kai_status\",\n    source: \"core\",\n    description:\n      \"KAI Core status as seen by the MCP Bridge plugin (read-only): AI privacy mode, the local \" +\n      \"runtime (active model, loading stage, inference queue), the interface language, and which \" +\n      \"plugin sources the user has opened to agents in the bridge. Start here.\",\n    inputSchema: obj(),\n    handler: (ctx) => ({\n      bridge: { id: ctx.api.plugin.id, version: ctx.api.plugin.version, allowChanges: ctx.allowChanges, sources: ctx.sources },\n      privacy: ctx.api.network.status(),\n      runtime: ctx.api.runtime.status(),\n      language: ctx.api.locale?.get?.().language ?? null,\n    }),\n  },\n  {\n    name: \"models_list\",\n    source: \"core\",\n    description:\n      \"List KAI's local models (read-only): alias, label, status (ready / partial / absent), \" +\n      \"expected weights size, full download size and bytes on disk. Use an alias that is ready \" +\n      \"with KAI's OpenAI-compatible /v1/chat/completions API on 127.0.0.1:41100 for inference.\",\n    inputSchema: obj(),\n    handler: (ctx) => ({ models: ctx.api.models.list() }),\n  },\n  {\n    name: \"model_ensure\",\n    source: \"core\",\n    mutating: true,\n    approval: \"core\",\n    description:\n      \"CHANGE — ask KAI to download (if needed) and load a local model by alias. KAI shows its own \" +\n      \"review in its window, with the download size, and the user approves or cancels there. \" +\n      \"Downloads can be several GB.\",\n    inputSchema: obj({ alias: str(\"Model alias from models_list, e.g. koinos-balanced\") }, [\"alias\"]),\n    handler: async (ctx, args) => {\n      const alias = id(args.alias, \"alias\");\n      const known = ctx.api.models.list().map((m) => m.alias);\n      if (!known.includes(alias)) throw Error(`Unknown alias \"${alias}\". Known aliases: ${known.join(\", \")}`);\n      return { requested: alias, result: await ctx.api.models.ensure({ alias }, ctx.signal) };\n    },\n  },\n  {\n    name: \"privacy_set\",\n    source: \"core\",\n    mutating: true,\n    approval: \"core\",\n    description:\n      \"CHANGE — ask KAI to change its AI privacy mode: 'local-only' (nothing leaves this computer), \" +\n      \"'local-first' (network fallback) or 'network'. Any mode other than local-only can send \" +\n      \"prompts to other computers. KAI reviews the change in its window.\",\n    inputSchema: obj({ mode: str(\"Privacy mode\", { enum: PRIVACY_MODES }) }, [\"mode\"]),\n    handler: async (ctx, args) => {\n      if (!PRIVACY_MODES.includes(args.mode)) throw Error(`mode must be one of: ${PRIVACY_MODES.join(\", \")}`);\n      return ctx.api.network.configure({ privacyMode: args.mode });\n    },\n  },\n\n  // ----- documents -----\n  {\n    name: \"documents_list\",\n    source: \"documents\",\n    description:\n      \"List the user's saved KAI Documents (read-only): id, title, last update, word count and a \" +\n      \"160-character preview, newest first.\",\n    inputSchema: obj(),\n    handler: via(\"documents\", \"list\"),\n  },\n  {\n    name: \"document_get\",\n    source: \"documents\",\n    description:\n      \"Read one KAI Document in full by id (read-only). The result carries a revision; pass it back \" +\n      \"to document_save or document_remove so a document changed in the meantime is never overwritten.\",\n    inputSchema: obj({ id: str(\"Document id from documents_list\") }, [\"id\"]),\n    handler: (ctx, args) => ctx.call(\"kai.documents\", \"get\", { id: id(args.id) }),\n  },\n  {\n    name: \"document_save\",\n    source: \"documents\",\n    mutating: true,\n    approval: \"bridge\",\n    description:\n      \"CHANGE — create a new KAI Document, or replace an existing one's title and content. To \" +\n      \"update, pass the id and the revision from document_get; a stale revision is refused. The \" +\n      \"user approves in the KAI window.\",\n    inputSchema: obj({\n      title: str(\"Title (up to 200 characters)\"),\n      content: str(\"Full document text (Markdown is fine)\"),\n      id: str(\"Existing document id, to update it\"),\n      revision: str(\"Revision from document_get (required with id)\"),\n    }, [\"content\"]),\n    confirm: (args) => ({\n      title: args.id ? \"Update a document?\" : \"Create a document?\",\n      detail: `${args.id ? `Replace document ${args.id}` : \"Create a new document\"}: “${args.title || \"Untitled\"}” (${String(args.content ?? \"\").length} characters).`,\n    }),\n    handler: (ctx, args) => {\n      const input = { content: text(args.content, \"content\", 10_000_000), title: typeof args.title === \"string\" ? args.title : \"\" };\n      if (args.id !== undefined) {\n        input.id = id(args.id);\n        input.revision = text(args.revision, \"revision\", 200);\n      }\n      return ctx.call(\"kai.documents\", \"save\", input);\n    },\n  },\n  {\n    name: \"document_remove\",\n    source: \"documents\",\n    mutating: true,\n    approval: \"provider\",\n    description:\n      \"CHANGE, DESTRUCTIVE — delete a KAI Document. Documents asks the user to confirm in its own \" +\n      \"dialog. The current revision is fetched automatically when not supplied.\",\n    inputSchema: obj({ id: str(\"Document id\"), revision: str(\"Revision from document_get (optional)\") }, [\"id\"]),\n    handler: async (ctx, args) => {\n      const docId = id(args.id);\n      const revision = typeof args.revision === \"string\" ? args.revision : (await ctx.call(\"kai.documents\", \"get\", { id: docId }))?.revision;\n      return ctx.call(\"kai.documents\", \"remove\", { id: docId, revision });\n    },\n  },\n\n  // ----- workflows -----\n  {\n    name: \"workflows_list\",\n    source: \"workflows\",\n    description:\n      \"List the user's KAI Workflows (read-only): id, name, whether it is still a draft, and its \" +\n      \"revision. Only saved (non-draft) workflows can be run.\",\n    inputSchema: obj(),\n    handler: via(\"workflows\", \"listServices\"),\n  },\n  {\n    name: \"workflow_get\",\n    source: \"workflows\",\n    description: \"Read one KAI Workflow's full definition by id (read-only).\",\n    inputSchema: obj({ id: str(\"Workflow id from workflows_list\") }, [\"id\"]),\n    handler: (ctx, args) => ctx.call(\"kai.workflows\", \"get\", { id: id(args.id) }),\n  },\n  {\n    name: \"workflow_status\",\n    source: \"workflows\",\n    description:\n      \"Status of a workflow run by run id, or of the Workflows runtime when no id is given (read-only).\",\n    inputSchema: obj({ id: str(\"Run id returned by workflow_run (optional)\") }),\n    handler: (ctx, args) => ctx.call(\"kai.workflows\", \"status\", args.id === undefined ? {} : { id: id(args.id) }),\n  },\n  {\n    name: \"workflow_run\",\n    source: \"workflows\",\n    mutating: true,\n    approval: \"provider\",\n    description:\n      \"CHANGE — start a saved KAI Workflow with an optional text input. Workflows shows the user \" +\n      \"the workflow name, input and revision and asks before starting. Returns the run id; follow \" +\n      \"it with workflow_status. A workflow can use the network, connected accounts or credits \" +\n      \"according to how the user built it.\",\n    inputSchema: obj({\n      id: str(\"Workflow id\"),\n      input: str(\"Text input for the run (optional)\"),\n      revision: { type: \"integer\", description: \"Expected revision from workflows_list (optional; a changed workflow is refused)\" },\n    }, [\"id\"]),\n    handler: (ctx, args) => ctx.call(\"kai.workflows\", \"run\", {\n      id: id(args.id),\n      ...(typeof args.input === \"string\" ? { input: args.input } : {}),\n      ...(Number.isInteger(args.revision) ? { revision: args.revision } : {}),\n    }),\n  },\n  {\n    name: \"workflow_cancel\",\n    source: \"workflows\",\n    mutating: true,\n    approval: \"bridge\",\n    description: \"CHANGE — cancel a running workflow by run id. The user approves in the KAI window.\",\n    inputSchema: obj({ id: str(\"Run id returned by workflow_run\") }, [\"id\"]),\n    confirm: (args) => ({ title: \"Cancel a workflow run?\", detail: `Stop workflow run ${args.id}.` }),\n    handler: (ctx, args) => ctx.call(\"kai.workflows\", \"cancel\", { id: id(args.id) }),\n  },\n\n  // ----- brain -----\n  {\n    name: \"brain_search\",\n    source: \"brain\",\n    description:\n      \"Search the user's KAI Brain memories (read-only): notes and source excerpts ranked for the \" +\n      \"query. Optional category narrows the search.\",\n    inputSchema: obj({\n      query: str(\"What to look for\"),\n      count: { type: \"integer\", minimum: 1, maximum: 25, description: \"Maximum results (default 8)\" },\n      category: str(\"Only this category (optional)\"),\n    }, [\"query\"]),\n    handler: (ctx, args) => ctx.call(\"kai.brain\", \"search\", {\n      query: text(args.query, \"query\", 2000),\n      count: Number.isInteger(args.count) ? Math.min(Math.max(args.count, 1), 25) : 8,\n      ...(typeof args.category === \"string\" ? { category: args.category } : {}),\n    }),\n  },\n  {\n    name: \"brain_goals\",\n    source: \"brain\",\n    description: \"List the goals the user keeps in KAI Brain (read-only).\",\n    inputSchema: obj(),\n    handler: via(\"brain\", \"goals\"),\n  },\n  {\n    name: \"brain_sources\",\n    source: \"brain\",\n    description: \"List the sources (files, folders, sites) the user has connected to KAI Brain (read-only).\",\n    inputSchema: obj(),\n    handler: via(\"brain\", \"sourceList\"),\n  },\n  {\n    name: \"brain_remember\",\n    source: \"brain\",\n    mutating: true,\n    approval: \"provider\",\n    description:\n      \"CHANGE — save a new memory note to KAI Brain. Brain shows the note to the user and saves it \" +\n      \"only if they approve; it is marked as agent-written.\",\n    inputSchema: obj({\n      text: str(\"The memory (up to 12,000 characters)\"),\n      title: str(\"Short title (optional)\"),\n      category: str(\"Category (optional; Brain falls back to notes)\"),\n      tags: { type: \"array\", items: { type: \"string\" }, description: \"Up to 12 tags (optional)\" },\n    }, [\"text\"]),\n    handler: (ctx, args) => ctx.call(\"kai.brain\", \"remember\", {\n      text: text(args.text, \"text\", 12000),\n      ...(typeof args.title === \"string\" ? { title: args.title } : {}),\n      ...(typeof args.category === \"string\" ? { category: args.category } : {}),\n      ...(Array.isArray(args.tags) ? { tags: args.tags.filter((t) => typeof t === \"string\").slice(0, 12) } : {}),\n    }),\n  },\n  {\n    name: \"brain_forget\",\n    source: \"brain\",\n    mutating: true,\n    approval: \"provider\",\n    description:\n      \"CHANGE, DESTRUCTIVE — remove a personal memory note from KAI Brain by id (from brain_search). \" +\n      \"Brain shows the note and asks the user first. Notes that belong to a connected source cannot be removed this way.\",\n    inputSchema: obj({ id: str(\"Memory note id\") }, [\"id\"]),\n    handler: (ctx, args) => ctx.call(\"kai.brain\", \"forget\", { id: id(args.id) }),\n  },\n\n  // ----- assistant -----\n  {\n    name: \"chats_list\",\n    source: \"assistant\",\n    description:\n      \"List the user's KAI Assistant conversations (titles and metadata). Assistant asks the user \" +\n      \"in its own dialog every time a plugin lists them.\",\n    inputSchema: obj(),\n    handler: via(\"assistant\", \"chats.list\"),\n  },\n  {\n    name: \"chat_get\",\n    source: \"assistant\",\n    description:\n      \"Read one KAI Assistant conversation by id. Assistant asks the user first, unless they \" +\n      \"already shared that conversation with the bridge (see chats_share).\",\n    inputSchema: obj({ id: str(\"Conversation id from chats_list\") }, [\"id\"]),\n    handler: (ctx, args) => ctx.call(\"kai.assistant\", \"chats.get\", { id: id(args.id) }),\n  },\n  {\n    name: \"chats_share\",\n    source: \"assistant\",\n    mutating: true,\n    approval: \"provider\",\n    description:\n      \"CHANGE — ask the user to share up to 100 Assistant conversations with the bridge so chat_get \" +\n      \"can read them without a dialog each time. Assistant lists them and asks; access lasts until \" +\n      \"revoked (chats_revoke, or Assistant Settings).\",\n    inputSchema: obj({ ids: { type: \"array\", items: { type: \"string\" }, maxItems: 100, description: \"Conversation ids\" } }, [\"ids\"]),\n    handler: (ctx, args) => {\n      if (!Array.isArray(args.ids) || !args.ids.length) throw Error(\"Missing required argument: ids (non-empty array)\");\n      return ctx.call(\"kai.assistant\", \"chats.grant\", { ids: args.ids.map((v) => id(v)).slice(0, 100) });\n    },\n  },\n  {\n    name: \"chats_revoke\",\n    source: \"assistant\",\n    mutating: true,\n    approval: \"none\",\n    description: \"CHANGE — withdraw every Assistant conversation previously shared with the bridge. Only ever reduces access.\",\n    inputSchema: obj(),\n    handler: via(\"assistant\", \"chats.revoke\"),\n  },\n\n  // ----- code / tools -----\n  {\n    name: \"code_projects\",\n    source: \"code\",\n    description: \"List the user's Koinos Code projects (read-only): id, name, and whether the folder is missing.\",\n    inputSchema: obj(),\n    handler: via(\"code\", \"projects\"),\n  },\n  {\n    name: \"tools_list\",\n    source: \"tools\",\n    description:\n      \"List the tools registered in KAI Tools — built-in tools and the MCP servers the user added to \" +\n      \"KAI (read-only; names and descriptions only). The bridge cannot run them.\",\n    inputSchema: obj(),\n    handler: async (ctx) => {\n      const out = await ctx.call(\"kai.tools\", \"list\", {});\n      const list = Array.isArray(out?.tools) ? out.tools : [];\n      return {\n        tools: list.map((t) => ({\n          name: t?.name ?? null,\n          description: typeof t?.description === \"string\" ? t.description.slice(0, 300) : null,\n          ...(t?.server ? { server: t.server } : {}),\n          ...(t?.source ? { source: t.source } : {}),\n          ...(typeof t?.egress === \"boolean\" ? { egress: t.egress } : {}),\n        })),\n      };\n    },\n  },\n];\n\nfunction annotations(tool) {\n  return {\n    readOnlyHint: !tool.mutating,\n    ...(tool.mutating ? { destructiveHint: /DESTRUCTIVE/.test(tool.description) } : {}),\n    openWorldHint: false,\n  };\n}\n\n/** The tools visible under the user's current bridge settings. */\nfunction visibleTools({ sources = {}, allowChanges = false } = {}) {\n  return tools.filter((t) => (t.source === \"core\" || sources[t.source] === true) && (!t.mutating || allowChanges));\n}\n\nmodule.exports = { tools, visibleTools, annotations, SOURCES, PRIVACY_MODES };\n","style.css":":root {\n  color-scheme: light dark;\n  --bg: #f6f6f4;\n  --card: #ffffff;\n  --text: #1c1d1f;\n  --muted: #62666d;\n  --line: #dfe0e2;\n  --accent: #2f6fde;\n  --accent-text: #ffffff;\n  --ok: #1f8a4c;\n  --bad: #c0362c;\n  --field: #f1f2f4;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #141517;\n    --card: #1d1f22;\n    --text: #e9eaec;\n    --muted: #9a9ea6;\n    --line: #2e3136;\n    --accent: #5b8ff0;\n    --accent-text: #0d1117;\n    --ok: #4cc17f;\n    --bad: #ef6b60;\n    --field: #26292d;\n  }\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: var(--bg); color: var(--text); }\nbody { font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; }\nmain { max-width: 760px; margin: 0 auto; padding: 24px 16px 40px; display: grid; gap: 14px; }\nmain > * { min-width: 0; }\nh1 { font-size: 22px; margin: 0 0 4px; }\nh2 { font-size: 15px; margin: 0 0 10px; }\n.lede, .hint, small { color: var(--muted); }\n.hint { margin: 8px 0 0; font-size: 13px; }\n.top { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }\n.card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px; }\n.row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }\n.row h2 { margin: 0; }\n.state { margin: 0; }\n.pill { border-radius: 999px; padding: 3px 12px; font-size: 12px; font-weight: 600; white-space: nowrap; border: 1px solid var(--line); }\n.pill-on { color: var(--ok); border-color: var(--ok); }\n.pill-off { color: var(--muted); }\n.pill-error { color: var(--bad); border-color: var(--bad); }\n.error { color: var(--bad); margin: 10px 0 0; }\nbutton { font: inherit; padding: 6px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--field); color: var(--text); cursor: pointer; }\nbutton:disabled { opacity: 0.6; cursor: default; }\nbutton.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); font-weight: 600; }\nbutton.quiet { background: transparent; }\ninput[type=\"text\"], input[type=\"password\"], input[type=\"number\"], textarea {\n  font: 13px/1.4 ui-monospace, SFMono-Regular, Consolas, monospace;\n  width: 100%; min-width: 0; padding: 7px 9px; border-radius: 8px; border: 1px solid var(--line);\n  background: var(--field); color: var(--text);\n}\ntextarea { resize: vertical; }\ninput[type=\"number\"] { max-width: 140px; }\n.field { display: grid; gap: 6px; margin: 0 0 12px; }\n.field > span:first-child { font-weight: 600; font-size: 13px; }\n.field > button { justify-self: start; }\n.inline { display: flex; gap: 8px; align-items: center; min-width: 0; }\n.checks { display: grid; gap: 10px; margin: 6px 0 14px; }\n.check { display: flex; gap: 10px; align-items: flex-start; }\n.check input { margin-top: 3px; }\n.check span { display: grid; gap: 1px; }\n.check.strong { padding-top: 12px; border-top: 1px solid var(--line); }\n.activity { list-style: none; padding: 0; margin: 8px 0 0; font: 12px/1.6 ui-monospace, Consolas, monospace; max-height: 260px; overflow: auto; }\n.activity li { white-space: pre-wrap; overflow-wrap: anywhere; }\n.activity .bad { color: var(--bad); }\n.activity .muted { color: var(--muted); }\n@media (max-width: 520px) {\n  .top { flex-direction: column; }\n  .inline { flex-wrap: wrap; }\n}\n"},"publicKey":"MCowBQYDK2VwAyEAGSgBWXfohza4Rkm9Mkg3yfqMHWVXojy5fOcV2KVIAGI=","signature":"fFHxCaw3jyjm7F9Syf9ON8u1bqL6KZqQp6YdsOGmYhw88YbtVQIUe3yVqhckoMfVypX00u3OJqtDv3UZhp4HDA=="}